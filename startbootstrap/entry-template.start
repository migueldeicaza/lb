@ENTRY_ANCHOR@<article class="post">
  <header class="post-header">
    <p class="eyebrow"><a href="@ENTRY_ARCHIVE_URL@">Writing</a> <span aria-hidden="true">/</span> <time datetime="@ENTRY_DATEISO@">@ENTRY_DATECAPTION@</time></p>
    <h1>@ENTRY_CAPTION@</h1>
  </header>
  <div class="post-body">@ENTRY_BODY@</div>
  <footer class="post-footer"><a href="@ENTRY_ARCHIVE_URL@">Browse the archive <span aria-hidden="true">→</span></a></footer>
</article>
